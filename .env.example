# Copia este archivo a .env.local y rellena los valores.
# Ver README.md para el paso a paso de Google Sheets.

# --- Sesiones -------------------------------------------------------------
# Cadena aleatoria de 32+ caracteres. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Base de datos (se activa en la fase 2) ----------------------------------
# "sheets" usa Google Sheets; "file" usa .data/db.json (solo desarrollo/tests).
# Si no se define: "sheets" cuando hay GOOGLE_SHEET_ID, "file" en caso contrario.
# DATA_BACKEND=sheets

# ID de la hoja: https://docs.google.com/spreadsheets/d/<ESTE_ES_EL_ID>/edit
GOOGLE_SHEET_ID=
# Email de la cuenta de servicio (campo client_email del JSON de credenciales)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada (campo private_key). Entre comillas dobles, con los saltos de
# línea como \n literales.
GOOGLE_PRIVATE_KEY=

# Milisegundos que se cachea la lectura de cada pestaña (por defecto 5000).
# SHEETS_CACHE_TTL_MS=5000
